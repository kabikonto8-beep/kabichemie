# Skopiuj do .env i ustaw własne hasła:  cp .env.example .env
# Plik .env jest w .gitignore i NIE trafia do repozytorium.

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_DB=kabi
POSTGRES_USER=kabi
POSTGRES_PASSWORD=zmien-to-haslo
POSTGRES_PORT=5432

# ------------------------------------------------------------------- pgAdmin
# Uwaga: pgAdmin waliduje adres i odrzuca zarezerwowane TLD (.local, .localhost).
PGADMIN_EMAIL=admin@kabichemie.pl
PGADMIN_PASSWORD=zmien-to-haslo
PGADMIN_PORT=5050

# ------------------------------------------------------------- podgląd www/
WEB_PORT=8124

# ----------------------------------------------------------------- tłumaczenia
# Klucz DeepL API do mirrorów EN/DE/AR (localize_site.py). Free kończy się na
# ":fx". Potrzebny tylko przy nowych ciągach — gdy wszystko jest w cache
# i18n/translations-*.json, build tłumaczeń działa bez klucza.
DEEPL_API_KEY=
