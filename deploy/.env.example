# Skopiuj do deploy/.env i uzupełnij. Plik .env NIE trafia do repo.

# Baza treści (Neon/Supabase) — z sslmode=require
DATABASE_URL=postgresql://user:haslo@host/kabi?sslmode=require

# DeepL API — do tłumaczenia NOWEJ treści (Free kończy się na :fx).
# Gdy wszystkie ciągi są w cache i18n/, klucz nie jest potrzebny.
DEEPL_API_KEY=

# Domena panelu (musi wskazywać na ten host; Caddy weźmie dla niej cert).
PANEL_DOMAIN=panel.kondycjonowanie-wody.pl
# To samo — dozwolony host dla skryptu panelu (blokada localhost).
PANEL_HOSTS=panel.kondycjonowanie-wody.pl

# Gałąź repo, z której Vercel buduje publiczną stronę.
PANEL_GIT_BRANCH=master
